# Copy this file to .env.local and fill in values (Supabase -> Project Settings -> API).
# Never commit .env.local. Restart `npm run dev` after changing it.
#
# Leave both blank to run Folio local-only (browser storage, no sync).
# Setup: run supabase/schema.sql in the SQL editor. Users sign in at /login with
# email + password (Authentication -> Providers -> Email). To skip the confirmation
# email while developing, turn off "Confirm email" in that same provider.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# anon / publishable key. Safe in the browser; data is protected by RLS policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public URL of the deployed site. Confirmation emails link here, even when the
# sign-up happens on localhost. Also add it in Supabase -> Authentication ->
# URL Configuration (Site URL and Redirect URLs).
NEXT_PUBLIC_SITE_URL=https://folio-iota-taupe.vercel.app
